{
  "ignorePatterns": [
    { "pattern": "^http://localhost" },
    { "pattern": "^https://localhost" },
    { "pattern": "^http://127.0.0.1" },
    { "pattern": "^https://github.com/flying-coyote/securing-ai-best-practices" },
    { "pattern": "<release-sha>" }
  ],
  "replacementPatterns": [
    { "pattern": "^/", "replacement": "{{BASEURL}}/" }
  ],
  "httpHeaders": [
    {
      "urls": ["https://genai.owasp.org", "https://modelcontextprotocol.io", "https://csrc.nist.gov", "https://www.cisa.gov"],
      "headers": { "User-Agent": "Mozilla/5.0 (compatible; Link-Checker/1.0)" }
    },
    {
      "urls": ["https://github.com"],
      "headers": { "Accept": "text/html" }
    }
  ],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 203, 206, 301, 302, 307, 308, 401, 403, 405, 999],
  "ignoreHttpsErrors": false
}
